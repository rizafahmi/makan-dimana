---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props as Props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script>import "../scripts/app.ts";</script>
  </head>
  <body>
    <main class="km-page">
      <slot />
    </main>
  </body>
</html>
