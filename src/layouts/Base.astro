---
import "../styles/global.css";

interface Props {
  title: string;
  board?: boolean;
}
const { title, board } = Astro.props as Props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script>import "../scripts/app.ts";</script>
  </head>
  <body>
    <main class:list={["km-page", { "km-board": board }]}>
      <slot />
    </main>
  </body>
</html>
