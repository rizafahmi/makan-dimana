---
import Base from "../../layouts/Base.astro";
import { getSession } from "../../lib/db.ts";

const session = getSession(Astro.params.id ?? "");
if (session === undefined) {
  return new Response(null, { status: 404 });
}
const title = String(session.title);
---

<Base title={title}>
  <h1>{title}</h1>
</Base>
