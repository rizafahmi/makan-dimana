---
import Base from "../../layouts/Base.astro";
import { getSession, recordVote, setSessionOpen } from "../../lib/db.ts";
import { readForm } from "../../lib/form.ts";
import { listPlaces, winningSlots } from "../../lib/session.ts";

const id = Astro.params.id ?? "";
const voteActions = ["upvote", "downvote"];
const allowedPlaces = ["1", "2", "3", "4"];
const sessionActions = ["close", "reopen"];
const invalidRequest = "Permintaan tidak valid";

let error: string | null = null;
let status = 400;

if (Astro.request.method === "POST") {
  const form = await readForm(Astro.request);
  if (form === null) return new Response(null, { status: 400 });
  const action = form.get("action");
  const place = form.get("place");

  if (
    typeof action !== "string" ||
    (!voteActions.includes(action) && !sessionActions.includes(action))
  ) {
    error = invalidRequest;
  } else if (sessionActions.includes(action)) {
    const result = setSessionOpen(id, action === "reopen");
    if (result.ok) return Astro.redirect(`/s/${id}`, 303);
    return new Response(null, { status: 404 });
  } else if (typeof place !== "string" || !allowedPlaces.includes(place)) {
    error = invalidRequest;
  } else {
    const result = recordVote(
      id,
      Number(place),
      action === "downvote" ? -1 : 1,
    );
    if (result.ok) return Astro.redirect(`/s/${id}`, 303);
    if (result.reason === "not_found")
      return new Response(null, { status: 404 });
    if (result.reason === "closed") {
      error = "Sesi sudah ditutup";
      status = 409;
    } else {
      error = invalidRequest;
    }
  }
  Astro.response.status = status;
}

const session = error === null ? getSession(id) : undefined;
if (error === null && session === undefined) {
  return new Response(null, { status: 404 });
}
const title = session === undefined ? invalidRequest : String(session.title);
const places = session === undefined ? [] : listPlaces(session);
const isOpen = session !== undefined && session.is_open === 1;
const winners = isOpen ? [] : winningSlots(places);
---

<Base title={title}>
  {
    error === null ? (
      <>
        <h1>{title}</h1>
        <ul>
          {places.map((place) => (
            <li
              data-place={place.slot}
              data-votes={place.votes}
              data-winner={winners.includes(place.slot) ? "true" : undefined}
            >
              {place.name}: {place.votes} suara{" "}
              {winners.includes(place.slot) && <strong>Pemenang</strong>}
              {isOpen && (
                <form method="post">
                  <input type="hidden" name="place" value={place.slot} />
                  <button name="action" value="upvote">
                    Naik
                  </button>{" "}
                  <button name="action" value="downvote">
                    Turun
                  </button>
                </form>
              )}
            </li>
          ))}
        </ul>
        {!isOpen && winners.length === 0 && <p>Belum ada pemenang</p>}
        {!isOpen && winners.length > 1 && <p>Seri!</p>}

        {isOpen ? (
          <form method="post">
            <button name="action" value="close">
              Tutup sesi
            </button>
          </form>
        ) : (
          <form method="post">
            <button name="action" value="reopen">
              Buka lagi
            </button>
          </form>
        )}
      </>
    ) : (
      <>
        <p>{error}</p>
        <p>
          <a href={`/s/${id}`}>Kembali ke sesi</a>
        </p>
      </>
    )
  }
</Base>
