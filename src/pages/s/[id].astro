---
import Base from "../../layouts/Base.astro";
import { getSession, recordVote } from "../../lib/db.ts";

const id = Astro.params.id ?? "";
const allowedActions = ["upvote", "downvote"];
const allowedPlaces = ["1", "2", "3", "4"];
const invalidRequest = "Permintaan tidak valid";

let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("action");
  const place = form.get("place");

  if (typeof action !== "string" || !allowedActions.includes(action)) {
    error = invalidRequest;
  } else if (typeof place !== "string" || !allowedPlaces.includes(place)) {
    error = invalidRequest;
  } else {
    const result = recordVote(
      id,
      Number(place),
      action === "downvote" ? -1 : 1,
    );
    if (result.ok) return Astro.redirect(`/s/${id}`, 303);
    if (result.reason === "not_found")
      return new Response(null, { status: 404 });
    error = invalidRequest;
  }
  Astro.response.status = 400;
}

const session = error === null ? getSession(id) : undefined;
if (error === null && session === undefined) {
  return new Response(null, { status: 404 });
}
const title = session === undefined ? invalidRequest : String(session.title);
const places =
  session === undefined
    ? []
    : [1, 2, 3, 4].flatMap((slot) => {
        const name = session[`place${slot}_name`];
        if (name === null || name === undefined) {
          return [];
        }
        return [
          {
            slot,
            name: String(name),
            votes: Number(session[`place${slot}_votes`]),
          },
        ];
      });
---

<Base title={title}>
  {
    error === null ? (
      <>
        <h1>{title}</h1>
        <ul>
          {places.map((place) => (
            <li data-place={place.slot} data-votes={place.votes}>
              {place.name}: {place.votes} suara
            </li>
          ))}
        </ul>
      </>
    ) : (
      <>
        <p>{error}</p>
        <p>
          <a href={`/s/${id}`}>Kembali ke sesi</a>
        </p>
      </>
    )
  }
</Base>
