---
import Base from "../layouts/Base.astro";
import { createSession } from "../lib/db.ts";
import { validateCreate } from "../lib/validate.ts";
import { readForm } from "../lib/form.ts";

let errors: Record<string, string> = {};
let values = { title: "", place1: "", place2: "", place3: "", place4: "" };

if (Astro.request.method === "POST") {
  const form = await readForm(Astro.request);
  if (form === null) return new Response(null, { status: 400 });
  values = {
    title: String(form.get("title") ?? ""),
    place1: String(form.get("place1") ?? ""),
    place2: String(form.get("place2") ?? ""),
    place3: String(form.get("place3") ?? ""),
    place4: String(form.get("place4") ?? ""),
  };
  const result = validateCreate({
    title: values.title,
    places: [values.place1, values.place2, values.place3, values.place4],
  });
  if (result.ok) {
    const id = createSession({ title: result.title, places: result.places });
    return Astro.redirect(`/s/${id}`, 303);
  }
  errors = result.errors;
  Astro.response.status = 422;
}
---

<Base title="Bikin sesi baru">
  <h1>Bikin sesi baru</h1>
  <form method="post">
    <input name="title" value={values.title} />
    {errors.title && <p>{errors.title}</p>}
    <input name="place1" value={values.place1} />
    {errors.place1 && <p>{errors.place1}</p>}
    <input name="place2" value={values.place2} />
    {errors.place2 && <p>{errors.place2}</p>}
    <input name="place3" value={values.place3} />
    {errors.place3 && <p>{errors.place3}</p>}
    <input name="place4" value={values.place4} />
    {errors.place4 && <p>{errors.place4}</p>}
    {errors.places && <p>{errors.places}</p>}
    <button>Bikin sesi</button>
  </form>
</Base>
