---
import Base from "../layouts/Base.astro";

if (Astro.request.method === "POST") {
  return new Response(null, { status: 405, headers: { allow: "GET" } });
}
---

<Base title="Bikin sesi baru">
  <a class="km-back km-nav" href="/">Semua sesi</a>
  <h1 class="km-h1">Bikin sesi baru</h1>
  <form class="km-form" method="post">
    <div class="km-field">
      <label for="title">Judul</label>
      <input class="km-input" name="title" id="title" />
    </div>
    <div class="km-field">
      <label for="place1">Tempat 1</label>
      <input class="km-input" name="place1" id="place1" />
    </div>
    <div class="km-field">
      <label for="place2">Tempat 2</label>
      <input class="km-input" name="place2" id="place2" />
    </div>
    <div class="km-field">
      <label for="place3">Tempat 3</label>
      <input class="km-input" name="place3" id="place3" />
    </div>
    <div class="km-field">
      <label for="place4">Tempat 4</label>
      <input class="km-input" name="place4" id="place4" />
    </div>
    <button class="km-button" data-block="true">Bikin sesi</button>
  </form>
</Base>
